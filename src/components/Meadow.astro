---
function mulberry32(seed: number) {
	let a = seed >>> 0;
	return () => {
		a = (a + 0x6d2b79f5) | 0;
		let t = Math.imul(a ^ (a >>> 15), 1 | a);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

const next = mulberry32(20241123);
const petal =
	"M0,-2.2 C-3.6,-8.4 -6.4,-14.6 -2.15,-18.5 C-0.7,-19.6 0.7,-19.6 2.15,-18.5 C6.4,-14.6 3.6,-8.4 0,-2.2 Z";
const ring = Array.from({ length: 14 }, (_, i) => +((i * 360) / 14).toFixed(2));

type Bloom = { kind: string; x: number; y: number; s: number; rot: number };

function field(opts: {
	y0: number;
	y1: number;
	stepX: number;
	stepY: number;
	min: number;
	max: number;
	jitter: number;
	kinds: string[];
}): Bloom[] {
	const out: Bloom[] = [];
	let row = 0;
	for (let y = opts.y0; y < opts.y1; y += opts.stepY, row++) {
		const shift = row % 2 ? opts.stepX * 0.5 : 0;
		for (let x = -opts.stepX; x < 1120; x += opts.stepX) {
			out.push({
				kind: opts.kinds[Math.floor(next() * opts.kinds.length)],
				x: +(x + shift + (next() - 0.5) * opts.jitter).toFixed(1),
				y: +(y + (next() - 0.5) * opts.jitter * 0.7).toFixed(1),
				s: +(opts.min + next() * (opts.max - opts.min)).toFixed(1),
				rot: Math.floor(next() * 360),
			});
		}
	}
	return out;
}

const warm = ["fl-white", "fl-blush", "fl-pink", "fl-hot", "fl-coral"];
const back = field({
	y0: 18,
	y1: 150,
	stepX: 16,
	stepY: 15,
	min: 12,
	max: 20,
	jitter: 6,
	kinds: warm,
});
const mid = field({
	y0: 78,
	y1: 230,
	stepX: 22,
	stepY: 22,
	min: 24,
	max: 40,
	jitter: 7,
	kinds: ["fl-white", "fl-blush", "fl-blush", "fl-pink", "fl-pink", "fl-hot", "fl-coral"],
});
const front = field({
	y0: 150,
	y1: 312,
	stepX: 28,
	stepY: 26,
	min: 40,
	max: 68,
	jitter: 8,
	kinds: ["fl-white", "fl-white", "fl-blush", "fl-pink", "fl-pink", "fl-hot", "fl-coral"],
});
const leaves = field({
	y0: 70,
	y1: 300,
	stepX: 36,
	stepY: 28,
	min: 16,
	max: 30,
	jitter: 12,
	kinds: ["leaf"],
});
---

<div class="meadow" aria-hidden="true">
	<svg viewBox="0 0 1100 300" preserveAspectRatio="xMidYMax slice">
		<defs>
			<radialGradient id="g-white" cx="50%" cy="50%" r="62%">
				<stop offset="0.28" stop-color="#f3a8c4" />
				<stop offset="0.62" stop-color="#ffe4ef" />
				<stop offset="1" stop-color="#fff7fb" />
			</radialGradient>
			<radialGradient id="g-blush" cx="50%" cy="50%" r="62%">
				<stop offset="0.26" stop-color="#e56b96" />
				<stop offset="0.64" stop-color="#f7c5d8" />
				<stop offset="1" stop-color="#fff1f6" />
			</radialGradient>
			<radialGradient id="g-pink" cx="50%" cy="50%" r="62%">
				<stop offset="0.24" stop-color="#c73b70" />
				<stop offset="0.6" stop-color="#f48fb4" />
				<stop offset="1" stop-color="#ffd6e6" />
			</radialGradient>
			<radialGradient id="g-hot" cx="50%" cy="50%" r="62%">
				<stop offset="0.22" stop-color="#9e2458" />
				<stop offset="0.58" stop-color="#e85a8c" />
				<stop offset="1" stop-color="#f7a3c0" />
			</radialGradient>
			<radialGradient id="g-coral" cx="50%" cy="50%" r="62%">
				<stop offset="0.24" stop-color="#c85a28" />
				<stop offset="0.62" stop-color="#ff8a65" />
				<stop offset="1" stop-color="#ffd0b8" />
			</radialGradient>
			<radialGradient id="heart" cx="42%" cy="40%" r="60%">
				<stop offset="0" stop-color="#fff6d2" />
				<stop offset="0.46" stop-color="#f6c445" />
				<stop offset="1" stop-color="#e07a22" />
			</radialGradient>
			<linearGradient id="mist" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" stop-color="#ffffff" />
				<stop offset="1" stop-color="#ffffff" stop-opacity="0" />
			</linearGradient>
			<linearGradient id="soil" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" stop-color="#e7c4a8" stop-opacity="0" />
				<stop offset="1" stop-color="#e3b48f" stop-opacity="0.55" />
			</linearGradient>
			<symbol id="fl-white" viewBox="-20 -20 40 40">
				<ellipse cx="0" cy="3" rx="11" ry="6.5" fill="#1d4a30" opacity="0.28" />
				<g fill="url(#g-white)">{ring.map((a) => <path d={petal} transform={`rotate(${a})`} />)}</g>
				<circle r="3.5" fill="url(#heart)" />
			</symbol>
			<symbol id="fl-blush" viewBox="-20 -20 40 40">
				<ellipse cx="0" cy="3" rx="11" ry="6.5" fill="#1d4a30" opacity="0.3" />
				<g fill="url(#g-blush)">{ring.map((a) => <path d={petal} transform={`rotate(${a})`} />)}</g>
				<circle r="3.6" fill="url(#heart)" />
			</symbol>
			<symbol id="fl-pink" viewBox="-20 -20 40 40">
				<ellipse cx="0" cy="3" rx="11" ry="6.5" fill="#1d4a30" opacity="0.32" />
				<g fill="url(#g-pink)">{ring.map((a) => <path d={petal} transform={`rotate(${a})`} />)}</g>
				<circle r="3.7" fill="url(#heart)" />
			</symbol>
			<symbol id="fl-hot" viewBox="-20 -20 40 40">
				<ellipse cx="0" cy="3" rx="11" ry="6.5" fill="#1d4a30" opacity="0.34" />
				<g fill="url(#g-hot)">{ring.map((a) => <path d={petal} transform={`rotate(${a})`} />)}</g>
				<circle r="3.5" fill="url(#heart)" />
			</symbol>
			<symbol id="fl-coral" viewBox="-20 -20 40 40">
				<ellipse cx="0" cy="3" rx="11" ry="6.5" fill="#1d4a30" opacity="0.3" />
				<g fill="url(#g-coral)">{ring.map((a) => <path d={petal} transform={`rotate(${a})`} />)}</g>
				<circle r="3.8" fill="#6b3a22" />
				<circle r="2.1" fill="#f6c445" />
			</symbol>
			<symbol id="leaf" viewBox="0 0 28 16">
				<path d="M1 10 C8 1 18 0 26 7 C17 8 10 12 1 10 Z" fill="#2f6b3a" />
				<path d="M3 9 C10 4 18 3 24 7 C16 8 9 10 3 9 Z" fill="#3e8f4e" />
			</symbol>
		</defs>

		<rect y="230" width="1100" height="70" fill="url(#soil)" />
		{
			leaves.map((item) => (
				<use
					href="#leaf"
					width={item.s}
					height={item.s * 0.58}
					transform={`translate(${item.x} ${item.y}) rotate(${item.rot} ${item.s / 2} ${(item.s * 0.58) / 2})`}
				/>
			))
		}
		{
			[...back, ...mid, ...front].map((item) => (
				<use
					href={`#${item.kind}`}
					width={item.s}
					height={item.s}
					transform={`translate(${item.x} ${item.y}) rotate(${item.rot} ${item.s / 2} ${item.s / 2})`}
				/>
			))
		}
		<rect width="1100" height="28" fill="url(#mist)" />
	</svg>
</div>

<style>
	.meadow {
		align-self: stretch;
		position: relative;
		width: 100%;
		min-width: 0;
		flex: 1 0 auto;
		min-height: min(44vh, 320px);
		margin-top: 4px;
		overflow: hidden;
		pointer-events: none;
		z-index: 0;
	}
	.meadow svg {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
	}
	@media (max-width: 640px) {
		.meadow {
			min-height: min(36vh, 220px);
		}
	}
</style>
