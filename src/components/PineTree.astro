---
---

<div class="pine-wrap" aria-hidden="true">
	<svg viewBox="0 0 420 900" preserveAspectRatio="xMidYMax meet">
		<defs>
			<filter id="pineRough" x="-40%" y="-40%" width="180%" height="180%">
				<feTurbulence type="fractalNoise" baseFrequency="0.012 0.02" numOctaves="2" seed="7" result="noise" />
				<feDisplacementMap in="SourceGraphic" in2="noise" scale="22" xChannelSelector="R" yChannelSelector="G" />
			</filter>
			<filter id="barkRough" x="-20%" y="-20%" width="140%" height="140%">
				<feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="2" seed="3" result="noise2" />
				<feDisplacementMap in="SourceGraphic" in2="noise2" scale="4" xChannelSelector="R" yChannelSelector="G" />
			</filter>
		</defs>

		<!-- trunk -->
		<path
			class="trunk"
			filter="url(#barkRough)"
			d="M196,900
			   C168,780 118,730 142,610
			   C156,540 100,470 136,380
			   C152,338 118,300 140,246
			   C150,222 172,208 178,180
			   C180,168 186,160 194,156
			   C200,160 202,168 200,178
			   C196,206 174,220 170,250
			   C154,304 186,340 170,384
			   C138,472 190,540 178,608
			   C158,726 206,778 228,900
			   Z"
		/>

		<!-- lower side branch -->
		<path
			class="branch"
			filter="url(#barkRough)"
			d="M150,560 C100,540 40,548 -10,520 L-8,508 C44,528 104,524 156,546 Z"
		/>

		<!-- pine foliage clusters: each is a layered cloud of needles -->
		<g class="cluster" transform="translate(30,520)">
			<ellipse class="needle-dark" cx="0" cy="10" rx="128" ry="34" filter="url(#pineRough)" />
			<ellipse class="needle-mid" cx="18" cy="-6" rx="108" ry="28" filter="url(#pineRough)" />
			<ellipse class="needle-light" cx="34" cy="-18" rx="70" ry="18" filter="url(#pineRough)" />
		</g>

		<g class="cluster" transform="translate(150,370)">
			<ellipse class="needle-dark" cx="0" cy="8" rx="96" ry="30" filter="url(#pineRough)" />
			<ellipse class="needle-mid" cx="14" cy="-8" rx="78" ry="23" filter="url(#pineRough)" />
			<ellipse class="needle-light" cx="26" cy="-16" rx="48" ry="14" filter="url(#pineRough)" />
		</g>

		<g class="cluster" transform="translate(150,230)">
			<ellipse class="needle-dark" cx="0" cy="6" rx="78" ry="24" filter="url(#pineRough)" />
			<ellipse class="needle-mid" cx="12" cy="-8" rx="62" ry="19" filter="url(#pineRough)" />
			<ellipse class="needle-light" cx="20" cy="-14" rx="38" ry="11" filter="url(#pineRough)" />
		</g>

		<g class="cluster" transform="translate(188,172) scale(0.85)">
			<ellipse class="needle-dark" cx="0" cy="6" rx="66" ry="22" filter="url(#pineRough)" />
			<ellipse class="needle-mid" cx="10" cy="-8" rx="52" ry="17" filter="url(#pineRough)" />
			<ellipse class="needle-light" cx="16" cy="-14" rx="32" ry="10" filter="url(#pineRough)" />
		</g>
	</svg>
</div>

<style>
	.pine-wrap {
		position: fixed;
		left: 0;
		bottom: 0;
		width: min(30vw, 420px);
		height: 92vh;
		pointer-events: none;
		z-index: 0;
	}
	.pine-wrap svg {
		width: 100%;
		height: 100%;
		display: block;
		overflow: visible;
	}
	.trunk,
	.branch {
		fill: #4a4136;
	}
	.needle-dark {
		fill: #2f4a3a;
	}
	.needle-mid {
		fill: #3f6049;
	}
	.needle-light {
		fill: #5c7f5c;
	}
	@media (max-width: 900px) {
		.pine-wrap {
			display: none;
		}
	}
</style>
