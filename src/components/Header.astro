---
interface Props {
	size?: "home" | "default";
}

const { size = "default" } = Astro.props;
const isHome = size === "home";
---

<header>
	<a class:list={["identity", isHome && "is-home"]} href="/">
		<img src="/avatar.jpg" alt="" width={isHome ? 96 : 60} height={isHome ? 96 : 60} />
		<span>
			<strong>dwoduo</strong>
			<small>嵌入式 AI 算法 · 端侧性能优化</small>
		</span>
	</a>
</header>

<style>
	header {
		position: relative;
		z-index: 1;
		width: min(var(--page-width), calc(100% - 2 * var(--page-gutter)));
		max-width: 100%;
		margin: 10vh auto 0;
		padding: 0 var(--page-gutter);
		box-sizing: border-box;
		background: transparent;
		box-shadow: none;
	}
	.identity {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		color: inherit;
		text-decoration: none;
	}
	.identity img {
		width: 60px;
		height: 60px;
		border-radius: 50%;
		object-fit: cover;
		object-position: center 18%;
	}
	.identity strong,
	.identity small {
		display: block;
	}
	.identity strong {
		font-size: 1.25em;
		font-weight: 650;
		line-height: 1.3;
	}
	.identity small {
		margin-top: 0.15rem;
		color: #767676;
		font-size: 0.85em;
		line-height: 1.4;
	}
	.identity.is-home {
		gap: 1.05rem;
	}
	.identity.is-home img {
		width: 96px;
		height: 96px;
	}
	.identity.is-home strong {
		font-size: 32px;
	}
	.identity.is-home small {
		margin-top: 0.2rem;
		color: #8d8d8d;
		font-size: 18px;
	}
</style>
