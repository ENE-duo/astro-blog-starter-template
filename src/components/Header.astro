<header>
	<a class="identity" href="/">
		<img src="/avatar.jpg" alt="" width="96" height="96" />
		<span>
			<strong>dwoduo</strong>
			<small>嵌入式 AI 算法 / 端侧性能优化</small>
		</span>
	</a>
</header>

<style>
	header {
		position: relative;
		z-index: 1;
		width: 600px;
		max-width: calc(100% - 2em);
		margin: 10vh auto 0;
		padding: 0 1em;
		background: transparent;
		box-shadow: none;
	}
	.identity {
		display: flex;
		align-items: center;
		gap: 1.05rem;
		color: inherit;
		text-decoration: none;
	}
	.identity img {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		object-fit: cover;
		object-position: center 18%;
	}
	.identity strong,
	.identity small {
		display: block;
	}
	.identity strong {
		font-size: 32px;
		font-weight: 650;
		line-height: 1.3;
	}
	.identity small {
		margin-top: 0.2rem;
		color: #8d8d8d;
		font-size: 18px;
		line-height: 1.4;
	}
</style>
