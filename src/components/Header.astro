---
import HeaderLink from "./HeaderLink.astro";
---

<header>
	<a class="identity" href="/">
		<img src="/avatar.jpg" alt="" width="64" height="64" />
		<span>
			<strong>dwoduo</strong>
			<small>扎根，发芽，成长</small>
		</span>
	</a>
	<nav>
		<HeaderLink href="/blog">blog</HeaderLink>
		<HeaderLink href="/about">about</HeaderLink>
	</nav>
</header>

<style>
	header {
		width: 40rem;
		max-width: calc(100% - 2em);
		margin: 4.5rem auto 0;
		padding: 0 1em;
		background: transparent;
		box-shadow: none;
	}
	.identity {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		color: inherit;
		text-decoration: none;
	}
	.identity img {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		object-fit: cover;
		object-position: center 18%;
	}
	.identity strong,
	.identity small {
		display: block;
	}
	.identity strong {
		font-size: 1rem;
		font-weight: 650;
		line-height: 1.3;
	}
	.identity small {
		margin-top: 0.1rem;
		color: #8d8d8d;
		font-size: 0.92rem;
		line-height: 1.4;
	}
	nav {
		display: flex;
		gap: 1.15rem;
		margin-top: 1.35rem;
	}
	nav :global(a) {
		padding: 0;
		color: #2c2c2c;
		border-bottom: 0;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
