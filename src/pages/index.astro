---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION, ZONES } from "../consts";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="bio">
			<p class="lead">Hi，我是 dwoduo. 一个在代码里种树的人.</p>
			<p>白天，把模型塞进小小的端侧；闲暇，把日子揉进几行代码.</p>
			<p>心里有很多还没成型的念头，和一个模糊的梦. 它们像种子一样，正埋在土里.</p>
			<p>我会把做过的项目、走过的路，还有一些碎碎念，一点点搬到这里，然后一边记录，一边等它们野蛮生长.</p>
			<p class="motto">
				{
					ZONES.map((zone) => (
						<a class={`${zone.className} zone-link`} href={`/${zone.slug}`} aria-describedby={`tip-${zone.slug}`}>{zone.label}<span class="tip" id={`tip-${zone.slug}`} role="tooltip" hidden>{zone.tip}</span></a>
					))
				}
			</p>
		</main>
	</body>
</html>

<style>
	.bio {
		position: relative;
		z-index: 1;
		width: 600px;
		font-family: "LXGW WenKai Screen", "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
	}
	.lead {
		margin-bottom: 0;
		color: #333333;
		font-size: 19px;
		line-height: 1.7;
	}
	.bio p {
		margin-bottom: 14px;
		color: #555555;
		font-size: 16px;
		line-height: 1.7;
	}
	.bio p.motto {
		margin-top: 28px;
		margin-bottom: 0;
		font-size: 22px;
		font-weight: 700;
		letter-spacing: 2px;
		line-height: 1.6;
	}
	.bio p.motto .motto-root {
		color: #5c3d2e;
	}
	.bio p.motto .motto-sprout {
		color: #6fa84a;
	}
	.bio p.motto .motto-grow {
		color: #3d9ad9;
	}
	.bio p.motto a.zone-link {
		text-decoration: none;
		touch-action: manipulation;
	}
	.tip {
		position: fixed;
		z-index: 2;
		margin: 0;
		padding: 0 4px;
		background: #fff;
		color: #8d8d8d;
		font-size: 13px;
		font-weight: 400;
		letter-spacing: 0;
		line-height: 1.4;
		white-space: nowrap;
		pointer-events: none;
	}
</style>

<script>
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("a.zone-link"));
	let pointerKind = "mouse";

	function tipOf(link: HTMLAnchorElement) {
		const tip = link.querySelector<HTMLElement>(".tip");
		if (!tip) throw new Error("missing tip");
		return tip;
	}

	function hide(link: HTMLAnchorElement) {
		link.classList.remove("is-open");
		tipOf(link).hidden = true;
	}

	function place(link: HTMLAnchorElement) {
		const tip = tipOf(link);
		const host = link.getBoundingClientRect();
		const width = tip.offsetWidth;
		const margin = 8;
		const viewW = document.documentElement.clientWidth;
		const lowest = Math.max(...links.map((item) => item.getBoundingClientRect().bottom));
		const left = Math.min(
			Math.max(host.left + (host.width - width) / 2, margin),
			Math.max(margin, viewW - width - margin),
		);
		tip.style.left = `${left}px`;
		tip.style.top = `${lowest + 10}px`;
	}

	function show(link: HTMLAnchorElement) {
		for (const item of links) hide(item);
		const tip = tipOf(link);
		tip.hidden = false;
		link.classList.add("is-open");
		place(link);
	}

	document.addEventListener(
		"pointerdown",
		(event) => {
			pointerKind = event.pointerType;
			if (pointerKind !== "touch") return;
			const target = event.target;
			if (target instanceof Element && target.closest("a.zone-link")) return;
			for (const link of links) hide(link);
		},
		true,
	);

	document.addEventListener(
		"keydown",
		() => {
			pointerKind = "key";
		},
		true,
	);

	for (const link of links) {
		link.addEventListener("pointerenter", (event) => {
			if (event.pointerType === "touch") return;
			show(link);
		});
		link.addEventListener("pointerleave", (event) => {
			if (event.pointerType === "touch") return;
			hide(link);
		});
		link.addEventListener("focus", () => {
			if (pointerKind === "touch") return;
			show(link);
		});
		link.addEventListener("blur", () => {
			if (pointerKind === "touch") return;
			hide(link);
		});
		link.addEventListener("click", (event) => {
			if (pointerKind !== "touch" || link.classList.contains("is-open")) return;
			event.preventDefault();
			show(link);
		});
	}

	window.addEventListener("resize", () => {
		const open = links.find((link) => link.classList.contains("is-open"));
		if (open) place(open);
	});
</script>
