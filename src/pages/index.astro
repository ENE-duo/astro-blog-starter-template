---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="bio">
			<p class="lead">Hi，我是 dwoduo. 一个在代码里种树的人.</p>
			<p>白天，把模型塞进小小的端侧；闲暇，把日子揉进几行代码.</p>
			<p>心里有很多还没成型的念头，和一个模糊的梦. 它们像种子一样，正埋在土里.</p>
			<p>我会把做过的项目、走过的路，还有一些碎碎念，一点点搬到这里，然后一边记录，一边等它们野蛮生长.</p>
			<p class="motto">
				<span class="motto-root">Take root</span><span class="motto-sprout">,sprout,and then</span><span class="motto-grow"> grow wildly</span>
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.bio {
		position: relative;
		z-index: 1;
		width: 600px;
		font-family: "LXGW WenKai Screen", "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
	}
	.lead {
		margin-bottom: 0;
		color: #333333;
		font-size: 19px;
		line-height: 1.7;
	}
	.bio p {
		margin-bottom: 14px;
		color: #555555;
		font-size: 16px;
		line-height: 1.7;
	}
	.bio p.motto {
		margin-top: 28px;
		margin-bottom: 0;
		font-size: 22px;
		font-weight: 700;
		letter-spacing: 2px;
		line-height: 1.6;
	}
	.bio p.motto .motto-root {
		color: #5c3d2e;
	}
	.bio p.motto .motto-sprout {
		color: #6fa84a;
	}
	.bio p.motto .motto-grow {
		color: #3d9ad9;
	}
</style>
