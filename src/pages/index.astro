---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PineTree from "../components/PineTree.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<PineTree />
		<Header />
		<main class="bio">
			<p class="lead">Hi，我是 dwoduo，2005 年生。一个在代码里种树的人。</p>
			<div class="tags">
				<span>嵌入式 AI 算法</span>
				<span>端侧性能优化</span>
			</div>
			<p>白天，把模型塞进小小的端侧；闲暇，把日子揉进几行代码。</p>
			<p>心里有很多还没成型的念头，和一个模糊的梦。它们像种子一样，正埋在土里。</p>
			<p>我会把做过的项目、走过的路，还有一些碎碎念，一点点搬到这里，然后一边记录，一边等它们<span class="dash">——</span></p>
			<p class="motto">扎根，发芽，野蛮生长。</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.bio {
		position: relative;
		z-index: 1;
		width: 600px;
		font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
	}
	.lead {
		margin-bottom: 0;
		color: #333333;
		font-size: 19px;
		line-height: 1.7;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 8px;
		margin-bottom: 14px;
	}
	.tags span {
		padding: 2px 8px;
		border: 1px solid #e4e4e4;
		border-radius: 12px;
		color: #999999;
		font-size: 12px;
		line-height: 1.6;
		letter-spacing: 0.5px;
	}
	.bio p {
		margin-bottom: 14px;
		color: #555555;
		font-size: 16px;
		line-height: 1.7;
	}
	.dash {
		margin-inline: 0.35em;
	}
	.motto {
		margin-top: 28px;
		margin-bottom: 0;
		color: #000000;
		font-size: 22px;
		font-weight: 700;
		letter-spacing: 2px;
		line-height: 1.6;
	}
</style>
