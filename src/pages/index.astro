---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION, ZONES } from "../consts";

const [root, sprout, grow] = ZONES;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="bio">
			<p class="lead">Hi，我是 dwoduo<span class="en-dot">.</span> 一个在代码里种树的人<span class="en-dot">.</span></p>
			<p>白天，把模型塞进小小的端侧；闲暇，把日子揉进几行代码<span class="en-dot">.</span></p>
			<p>心里有很多还没成型的念头，和一个模糊的梦<span class="en-dot">.</span>它们像种子一样，正埋在土里<span class="en-dot">.</span></p>
			<p>所以，我会把做过的项目、走过的路，还有一些碎碎念，一点点搬到这里<span class="en-dot">.</span></p>
			<p>然后一边记录，一边等它们扎根，发芽，野蛮生长<span class="en-dot">.</span></p>
			<div class="motto-wrap">
				<p class="motto">
					Take <a class="zone-link zone-root" href="/root/" data-tip={root.tip} title={root.tip}>root</a>,<a
						class="zone-link zone-sprout"
						href="/sprout/"
						data-tip={sprout.tip}
						title={sprout.tip}>sprout</a>,and then <a
						class="zone-link zone-grow"
						href="/grow/"
						data-tip={grow.tip}
						title={grow.tip}>grow</a> wildly
				</p>
				<p class="zone-hint" aria-live="polite"></p>
			</div>
		</main>
	</body>
</html>

<script>
	const wrap = document.querySelector(".motto-wrap");
	if (wrap) {
		const hint = wrap.querySelector(".zone-hint");
		const links = wrap.querySelectorAll(".zone-link");
		let hideTimer = 0;

		const tones = ["zone-root", "zone-sprout", "zone-grow"];

		const show = (link: Element) => {
			if (!hint) return;
			window.clearTimeout(hideTimer);
			hint.textContent = link.getAttribute("data-tip") ?? "";
			hint.classList.remove(...tones);
			const tone = tones.find((name) => link.classList.contains(name));
			if (tone) hint.classList.add(tone);
			if (hint.classList.contains("is-visible")) return;
			void hint.offsetWidth;
			hint.classList.add("is-visible");
		};

		const hide = () => {
			if (!hint) return;
			hideTimer = window.setTimeout(() => {
				hint.classList.remove("is-visible");
			}, 80);
		};

		links.forEach((link) => {
			link.addEventListener("mouseenter", () => show(link));
			link.addEventListener("mouseleave", hide);
			link.addEventListener("focus", () => show(link));
			link.addEventListener("blur", hide);
		});
	}
</script>

<style>
	.bio {
		position: relative;
		z-index: 1;
		width: min(var(--page-width), calc(100% - 2 * var(--page-gutter)));
		font-family: "LXGW WenKai Screen", "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
	}
	.en-dot {
		font-family: "Times New Roman", "Georgia", "Noto Serif", serif;
		font-style: normal;
	}
	.lead {
		margin-bottom: 0;
		color: #333333;
		font-size: 20px;
		line-height: 1.85;
	}
	.bio p {
		margin-bottom: 16px;
		color: #555555;
		font-size: 18px;
		line-height: 1.85;
	}
	.motto-wrap {
		margin-top: 28px;
	}
	.bio p.motto {
		margin: 0;
		color: #333333;
		font-size: 24px;
		font-weight: 700;
		letter-spacing: 2px;
		line-height: 1.75;
	}
	.zone-link {
		text-decoration: underline;
		text-decoration-skip-ink: none;
		text-underline-offset: 8px;
		text-decoration-thickness: 1.5px;
		cursor: pointer;
	}
	.zone-link:hover {
		text-decoration-thickness: 2px;
	}
	.zone-root {
		color: #5c3d2e;
	}
	.zone-sprout {
		color: #6fa84a;
	}
	.zone-grow {
		color: #3d9ad9;
	}
	.zone-hint {
		margin: 0;
		max-height: 0;
		overflow: hidden;
		color: #8d8d8d;
		font-size: 15px;
		font-weight: 400;
		letter-spacing: 0.5px;
		line-height: 1.6;
		opacity: 0;
		transform: translateY(-6px);
		transition:
			max-height 0.32s ease,
			margin-top 0.32s ease,
			opacity 0.32s ease,
			transform 0.32s ease;
	}
	.zone-hint.is-visible {
		margin-top: 10px;
		max-height: 2.4em;
		opacity: 1;
		transform: translateY(0);
	}
	.bio p.zone-hint.zone-root {
		color: #5c3d2e;
	}
	.bio p.zone-hint.zone-sprout {
		color: #6fa84a;
	}
	.bio p.zone-hint.zone-grow {
		color: #3d9ad9;
	}
</style>