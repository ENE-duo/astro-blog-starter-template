---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { ZONES } from "../consts";

export function getStaticPaths() {
	return ZONES.map((zone) => ({ params: { zone: zone.slug } }));
}

const zone = ZONES.find((item) => item.slug === Astro.params.zone)!;
const isSprout = zone.slug === "sprout";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${zone.title} · 分区`} description={zone.tip} />
	</head>
	<body>
		<Header />
		<main class="zone">
			<div class="zone-head">
				<h1 style={`color: ${zone.accent}`}>{zone.title}</h1>
				<a class="zone-return" href="/" style={`color: ${zone.accent}`}>← return</a>
			</div>
			<p class="zone-desc">{zone.blurb}</p>
			{isSprout && <hr class="zone-rule" />}

			{
				isSprout ? (
					<div class="sprout-board" data-section="chat">
						<div class="sprout-bar">
							<div class="sprout-labels" aria-hidden="true">
								<span class="sprout-label is-active" data-label="chat">唠唠嗑</span>
								<span class="sprout-label" data-label="work">工作</span>
								<span class="sprout-label" data-label="travel">旅途</span>
							</div>
							<div class="sprout-switch">
								<button type="button" class="sprout-nav" data-dir="prev" aria-label="上一个板块">‹</button>
								<button type="button" class="sprout-nav" data-dir="next" aria-label="下一个板块">›</button>
							</div>
						</div>
						<div class="sprout-viewport">
							<div class="sprout-track">
								<section class="sprout-pane" data-pane="chat" aria-label="唠唠嗑">
									<article class="chat-note">
										<p>走过了大四，顶着双非的标签，在比赛里摸爬滚打攒了些成绩，如今在一家做低空经济的公司写着边缘 AI 算法。</p>
										<p>建立这个博客，是为了记录我的人生成长。那些我熬夜学懂的知识，路上看过的风景，我都想写在这里。写给世界，更写给不敢懈怠的自己。</p>
										<p>因为，关于我在现实世界也要拿出真本事这回事！！！！ 我始终当真。</p>

										<h2><span class="chat-dot" aria-hidden="true"></span>动画</h2>
										<p>
											看过无数动画片，感悟最深的是 FLCL、来自深渊。2026 年 11 月在回顾的是飞天小女警 Z：
											<a
												href="https://www.bilibili.com/video/BV1vLnq6JEjr/"
												target="_blank"
												rel="noopener noreferrer">bilibili.com/video/BV1vLnq6JEjr</a>
										</p>

										<h2><span class="chat-dot" aria-hidden="true"></span>项目</h2>
										<p>
											2026 年 2 月 — 2026 年 12 月，网捕无人机机载主视觉链路（感知层面）：从数据采集 / 标注 → 模型架构融合 → 模型训练 → 端侧部署推理 → 端侧性能优化 → 跟踪算法。
										</p>
										<p>
											小红书相关视频：
											<a
												href="https://www.xiaohongshu.com/discovery/item/68c946c1000000001300e096?source=webshare&xhsshare=pc_web&xsec_token=ABPSrG_xshdoRohmujqtZh2EAmQJlm8cm7XGhSbNHpXRA=&xsec_source=pc_share"
												target="_blank"
												rel="noopener noreferrer">xiaohongshu.com/discovery/item/68c946c1000000001300e096</a>
										</p>
									</article>
								</section>
								<section class="sprout-pane" data-pane="work" aria-label="工作">
									<p class="zone-empty">
										还没有文章，先从<a href="/" style={`color: ${zone.accent}`}>首页</a>继续.
									</p>
								</section>
								<section class="sprout-pane" data-pane="travel" aria-label="旅途">
									<p class="zone-empty">
										还没有文章，先从<a href="/" style={`color: ${zone.accent}`}>首页</a>继续.
									</p>
								</section>
							</div>
						</div>
					</div>
				) : (
					<p class="zone-empty">
						还没有文章，先从<a href="/" style={`color: ${zone.accent}`}>首页</a>继续.
					</p>
				)
			}
		</main>
	</body>
</html>

{
	isSprout && (
		<script>
			const board = document.querySelector(".sprout-board");
			if (board) {
				const track = board.querySelector(".sprout-track");
				const labels = board.querySelectorAll(".sprout-label");
				const buttons = board.querySelectorAll(".sprout-nav");
				const order = ["chat", "work", "travel"] as const;

				const paint = (section: (typeof order)[number]) => {
					const index = order.indexOf(section);
					board.setAttribute("data-section", section);
					if (track instanceof HTMLElement) {
						track.style.transform = `translateX(-${(index * 100) / order.length}%)`;
					}
					labels.forEach((label) => {
						label.classList.toggle("is-active", label.getAttribute("data-label") === section);
					});
					buttons.forEach((button) => {
						const dir = button.getAttribute("data-dir");
						if (dir === "prev") button.toggleAttribute("disabled", index === 0);
						if (dir === "next") button.toggleAttribute("disabled", index === order.length - 1);
					});
				};

				const go = (dir: "prev" | "next") => {
					const current = Math.max(0, order.indexOf(board.getAttribute("data-section") as (typeof order)[number]));
					const next = dir === "next" ? Math.min(current + 1, order.length - 1) : Math.max(current - 1, 0);
					paint(order[next]);
				};

				buttons.forEach((button) => {
					button.addEventListener("click", () => {
						const dir = button.getAttribute("data-dir");
						if (dir === "prev" || dir === "next") go(dir);
					});
				});

				paint("chat");
			}
		</script>
	)
}

<style>
	.zone-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin: 0 0 0.75rem;
	}
	.zone h1 {
		margin: 0;
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: 1px;
	}
	.zone-return {
		flex: none;
		font-size: 15px;
		line-height: 1.4;
		text-decoration: none;
	}
	.zone-return:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.zone-desc {
		margin: 0 0 1.4rem;
		color: #555555;
		font-size: 16px;
		line-height: 1.8;
	}
	.zone-rule {
		margin: 0 0 1.15rem;
		border: 0;
		border-top: 2.5px solid #eeeeee;
	}
	.zone-empty {
		margin: 0;
		color: #8d8d8d;
		font-size: 15px;
	}
	.sprout-board {
		--sprout: #6fa84a;
	}
	.sprout-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin: 0 0 1rem;
	}
	.sprout-labels {
		display: flex;
		gap: 1.4rem;
		color: #555555;
		font-size: 18px;
		line-height: 1.6;
		user-select: none;
		pointer-events: none;
	}
	.sprout-label.is-active {
		color: var(--sprout);
	}
	.sprout-switch {
		display: flex;
		gap: 0.35rem;
	}
	.sprout-nav {
		width: 2.1rem;
		height: 2.1rem;
		padding: 0;
		border: 0;
		background: none;
		color: var(--sprout);
		font-size: 1.7rem;
		line-height: 1;
		cursor: pointer;
	}
	.sprout-nav:hover:not(:disabled) {
		opacity: 0.72;
	}
	.sprout-nav:disabled {
		opacity: 0.28;
		cursor: default;
	}
	.sprout-viewport {
		overflow: hidden;
		width: 100%;
	}
	.sprout-track {
		display: flex;
		width: 300%;
		transform: translateX(0);
		transition: transform 0.36s ease;
	}
	.sprout-pane {
		flex: 0 0 calc(100% / 3);
		width: calc(100% / 3);
		min-width: 0;
		padding-right: 1.25rem;
		box-sizing: border-box;
	}
	.chat-note {
		color: #444444;
		font-size: 16px;
		line-height: 1.85;
	}
	.chat-note p {
		margin: 0 0 1.2rem;
	}
	.chat-note h2 {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin: 1.55rem 0 0.65rem;
		color: #2c2c2c;
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	.chat-dot {
		display: inline-block;
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 50%;
		background: var(--sprout);
		flex: none;
	}
	.chat-note a {
		color: var(--sprout);
		text-decoration: underline;
		text-underline-offset: 3px;
		word-break: break-all;
	}
	.chat-note a:hover {
		opacity: 0.78;
	}
	@media (prefers-reduced-motion: reduce) {
		.sprout-track {
			transition: none;
		}
	}
</style>
