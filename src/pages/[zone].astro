---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { ZONES } from "../consts";

export function getStaticPaths() {
	return ZONES.map((zone) => ({ params: { zone: zone.slug } }));
}

const zone = ZONES.find((item) => item.slug === Astro.params.zone)!;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${zone.title} · 分区`} description={zone.tip} />
	</head>
	<body>
		<Header />
		<main class="zone">
			<h1 style={`color: ${zone.accent}`}>{zone.title}</h1>
			<p class="zone-desc">{zone.blurb}</p>
			<p class="zone-empty">还没有文章，先从<a href="/" style={`color: ${zone.accent}`}>首页</a>继续.</p>
		</main>
	</body>
</html>

<style>
	.zone h1 {
		margin: 0 0 0.75rem;
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: 1px;
	}
	.zone-desc {
		margin: 0 0 1.25rem;
		color: #555555;
		font-size: 16px;
		line-height: 1.7;
	}
	.zone-empty {
		margin: 0;
		color: #8d8d8d;
		font-size: 15px;
	}
</style>